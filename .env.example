# Configuración de Entorno - Proyecto MRP
# Stack LEMP Centralizado
# Fecha: 11 de febrero de 2026

# Entorno
APP_ENV=development
APP_DEBUG=true
APP_KEY=base64:MRP_SECRET_KEY_CHANGE_IN_PRODUCTION

# URLs
APP_URL=http://localhost
APP_PORT=80

# Base de Datos Principal (PostgreSQL)
DB_CONNECTION=mrp_auth
DB_PGSQL_HOST=postgresql
DB_PGSQL_PORT=5432
DB_PGSQL_DATABASE=mrp_demo
DB_PGSQL_USERNAME=mrp
DB_PGSQL_PASSWORD=ojp9Q6aYT3KHDE8sMS2u

# Base de Datos de Autenticación (PostgreSQL)
DB_AUTH_HOST=postgresql
DB_AUTH_PORT=5432
DB_AUTH_DATABASE=mrp_auth
DB_AUTH_USERNAME=mrp
DB_AUTH_PASSWORD=ojp9Q6aYT3KHDE8sMS2u

# Base de Datos Tenant (PostgreSQL)
# IMPORTANTE: DB_TENANT_DATABASE es solo fallback tecnico.
# El nombre real del tenant se resuelve dinamicamente desde mrp_auth.company_databases.
DB_TENANT_HOST=postgresql
DB_TENANT_PORT=5432
DB_TENANT_DATABASE=mrp_auth
DB_TENANT_USERNAME=mrp
DB_TENANT_PASSWORD=ojp9Q6aYT3KHDE8sMS2u

# Cache (Valkey/Redis)
CACHE_DRIVER=valkey
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_PASSWORD=null
VALKEY_DATABASE=0

# Cache alternativo (Memcached)
MEMCACHED_HOST=memcached
MEMCACHED_PORT=11211

# Sesiones
SESSION_DRIVER=database
SESSION_LIFETIME=120

# WebSocket
WEBSOCKET_HOST=websocket
WEBSOCKET_PORT=8080

# Logs
LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_PATH=/app/storage/logs

# Multiempresa
TENANT_MODE=enabled
DEFAULT_TENANT=demo

# CDN
CDN_ENABLED=true
CDN_URL=/CDN

# Email (configurar según necesidad)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@mrp.local
MAIL_FROM_NAME=MRP

# Backup
BACKUP_ENABLED=true
BACKUP_PATH=/app/database/backups

###############################################################################
# NOTAS IMPORTANTES:
#
# 1. HOSTS DE BASES DE DATOS:
#    - Usar 'postgresql' (nombre de contenedor en el stack LEMP)
#    - NO usar 'localhost' o '127.0.0.1' desde la aplicación PHP
#
# 2. DESDE EL HOST (tu máquina Windows):
#    - Usar 'localhost' o '127.0.0.1' para conectarse con clientes externos
#    - Ejemplo: phpMyAdmin, MySQL Workbench, pgAdmin, etc.
#
# 3. SEGURIDAD:
#    - ⚠️ CAMBIAR todas las contraseñas en producción
#    - ⚠️ Agregar .env al .gitignore
#    - ⚠️ Usar contraseñas fuertes y únicas por proyecto
#
# 4. USUARIO DE BASE DE DATOS:
#    - Se recomienda usar 'mrp' como usuario (nombre del proyecto)
#    - Otorgar permisos sobre las BD `mrp_%` para el alta de nuevas empresas
#
# 5. LOGS:
#    - Los logs de nginx y php-fpm están en:
#      D:\Gigliotti\Documentos\MartinG\WEBS\LEMP\logs\mrp\
#    - Los logs de la aplicación están en:
#      D:\Gigliotti\Documentos\MartinG\WEBS\mrp\storage\logs\
#
###############################################################################
