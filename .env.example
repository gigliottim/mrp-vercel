# Configuracion de Entorno - Proyecto MRP
# Stack LEPP en VPS Docker
# Fecha: 10 de marzo de 2026

# Aplicacion
APP_NAME=MRP
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:MRP_SECRET_KEY_CHANGE_IN_PRODUCTION
APP_TIMEZONE=America/Argentina/Buenos_Aires

# URL publica
APP_URL=https://mimrp.com.ar
APP_PORT=443

# Base de Datos Principal (PostgreSQL)
DB_CONNECTION=mrp_auth
DB_PGSQL_HOST=postgresql
DB_PGSQL_PORT=5432
DB_PGSQL_DATABASE=mrp_demo
DB_PGSQL_USERNAME=mrp_unik_2026
DB_PGSQL_PASSWORD=CHANGE_ME_DB_PASSWORD

# Base de Datos de Autenticacion (PostgreSQL)
DB_AUTH_HOST=postgresql
DB_AUTH_PORT=5432
DB_AUTH_DATABASE=mrp_auth
DB_AUTH_USERNAME=mrp_unik_2026
DB_AUTH_PASSWORD=CHANGE_ME_DB_PASSWORD

# Base de Datos Tenant (PostgreSQL)
# IMPORTANTE: DB_TENANT_DATABASE es solo fallback tecnico.
# El nombre real del tenant se resuelve dinamicamente desde mrp_auth.company_databases.
DB_TENANT_HOST=postgresql
DB_TENANT_PORT=5432
DB_TENANT_DATABASE=mrp_auth
DB_TENANT_USERNAME=mrp_unik_2026
DB_TENANT_PASSWORD=CHANGE_ME_DB_PASSWORD

# Sesiones
SESSION_DRIVER=database
SESSION_LIFETIME=120

# WebSocket (si se habilita)
WEBSOCKET_HOST=websocket
WEBSOCKET_PORT=8080

# Logs
LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_PATH=/app/storage/logs

# Multiempresa
TENANT_MODE=enabled

# CDN
CDN_ENABLED=true
CDN_URL=/CDN

# Email (configurar segun proveedor real)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@mrp.example.com
MAIL_FROM_NAME=MRP

# Backup
BACKUP_ENABLED=true
BACKUP_PATH=/app/database/backups

###############################################################################
# NOTAS IMPORTANTES:
#
# 1. HOST DE BASE DE DATOS DESDE LA APP:
#    - Usar 'postgresql' (nombre del servicio en docker-compose)
#    - NO usar localhost/127.0.0.1 dentro de la aplicacion PHP
#
# 2. CONEXION DESDE EL HOST/VPS:
#    - Puerto publicado: 5432
#    - Ejemplo: psql -h 127.0.0.1 -p 5432 -U mrp_unik_2026
#
# 3. SEGURIDAD:
#    - Cambiar claves en produccion
#    - No commitear valores reales sensibles
#
# 4. RUTAS EN VPS:
#    - Codigo app montado en /app
#    - Logs de app en /app/storage/logs
#    - Backups en /app/database/backups
#
###############################################################################
