# Variables usadas por docker-compose para servicios LEPP
# Completa estos valores antes de levantar en VPS

# PostgreSQL (bitnami/postgresql)
POSTGRESQL_USERNAME=mrp
POSTGRESQL_PASSWORD=change_this_strong_password
POSTGRESQL_DATABASE=mrp_auth

# pgAdmin (dpage/pgadmin4)
PGADMIN_DEFAULT_EMAIL=admin@mrp.local
PGADMIN_DEFAULT_PASSWORD=change_this_strong_password
