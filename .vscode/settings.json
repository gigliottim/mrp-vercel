{
    // ============================================================================
    // Configuración de VS Code para el Proyecto
    // ============================================================================
    // Esta configuración ayuda a mantener los estándares definidos en:
    // .github/instructions/unik.instructions.md
    // Límite máximo: 400 líneas por archivo
    // ============================================================================
    // ASOCIACIONES DE ARCHIVOS
    "files.associations": {
        "*.md": "markdown",
        "project-prompt.md": "markdown",
        "*.instructions.md": "markdown",
        "*.php": "php",
        "*.js": "javascript",
        ".env*": "dotenv"
    },
    // PHP - Validación via Docker
    "php.validate.executablePath": "${workspaceFolder}\\scripts\\php-docker.bat",
    // EDITOR - Configuración general
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.fixAll": "explicit"
    },
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.trimAutoWhitespace": true,
    "editor.detectIndentation": true,
    "editor.renderWhitespace": "boundary",
    "editor.wordWrap": "on",
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "editor.codeLens": true,
    // RULERS - Límites visuales según estándares del proyecto
    "editor.rulers": [
        80, // Línea de guía suave
        120, // Línea de guía recomendada
        {
            "column": 400,
            "color": "#ff0000" // LÍNEA ROJA: Límite máximo absoluto
        }
    ],
    // CONFIGURACIÓN ESPECÍFICA POR LENGUAJE
    "[php]": {
        "editor.tabSize": 4,
        "editor.rulers": [
            120,
            {
                "column": 400,
                "color": "#ff0000"
            }
        ]
    },
    "[javascript]": {
        "editor.tabSize": 2,
        "editor.rulers": [
            100,
            {
                "column": 300,
                "color": "#ff9900"
            }
        ]
    },
    "[css]": {
        "editor.tabSize": 2,
        "editor.rulers": [
            100,
            {
                "column": 400,
                "color": "#ff9900"
            }
        ]
    },
    "[html]": {
        "editor.tabSize": 2,
        "editor.rulers": [
            120,
            {
                "column": 200,
                "color": "#ff9900"
            }
        ]
    },
    "[json]": {
        "editor.tabSize": 2
    },
    "[markdown]": {
        "editor.wordWrap": "on",
        "files.trimTrailingWhitespace": false
    },
    // MARKDOWN
    "markdown.preview.fontSize": 14,
    "markdown.preview.lineHeight": 1.6,
    "markdown.preview.breaks": true,
    // FILES - Configuración de archivos
    "files.encoding": "utf8",
    "files.eol": "\n",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,
    "files.exclude": {
        "**/node_modules": true,
        "**/vendor": true,
        "**/.git": true,
        "**/storage/logs/*": true,
        "**/storage/cache/*": true,
        "**/*.min.js": true,
        "**/*.min.css": true
    },
    // SEARCH - Configuración de búsqueda
    "search.exclude": {
        "**/node_modules": true,
        "**/vendor": true,
        "**/storage/logs": true,
        "**/storage/cache": true,
        "**/*.min.js": true,
        "**/*.min.css": true
    },
    // PHP
    "php.suggest.basic": false,
    "php.validate.enable": true,
    "php.validate.run": "onSave",
    // JAVASCRIPT/CSS
    "css.validate": true,
    "javascript.validate.enable": true,
    "javascript.updateImportsOnFileMove.enabled": "always",
    // TYPESCRIPT
    "typescript.preferences.includePackageJsonAutoImports": "on",
    // EMMET
    "emmet.includeLanguages": {
        "php": "html",
        "javascript": "javascriptreact"
    },
    "emmet.triggerExpansionOnTab": true,
    // GIT
    "git.autofetch": true,
    "git.confirmSync": false,
    "git.enableSmartCommit": true,
    "git.ignoreLimitWarning": true,
    // TERMINAL
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.fontSize": 12,
    "terminal.integrated.cursorBlinking": true,
    // WORKBENCH
    "workbench.editor.enablePreview": false,
    "workbench.editor.highlightModifiedTabs": true,
    "workbench.startupEditor": "none",
    "workbench.experimental.maxFileSize": 400000,
    // COLORES PERSONALIZADOS - Ayudan a identificar límites
    "workbench.colorCustomizations": {
        "editorRuler.foreground": "#ff000055",
        "editorError.foreground": "#ff0000",
        "editorWarning.foreground": "#ff9900",
        "editorInfo.foreground": "#00aaff",
        "editor.lineHighlightBackground": "#ffffff10",
        "editor.lineHighlightBorder": "#ffffff20"
    },
    // BREADCRUMBS
    "breadcrumbs.enabled": true,
    "breadcrumbs.filePath": "on",
    "breadcrumbs.symbolPath": "on",
    // SEGURIDAD
    "security.workspace.trust.enabled": true,
    // NOTIFICACIONES
    "notification.sticky": false
}
